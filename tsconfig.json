{
  "compilerOptions": {
    "target": "es2020",
    "module": "CommonJS",
    "outDir": "out",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "prisma/**/*"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}